{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "src/main.ts",
        "src/**/*.test.ts",
        "controller/src/index.ts",
        "sdk/**/*.ts",
        "shared/**/*.ts",
        "scripts/{build-controller,build-sidecar,build-plugins,prepare-app-release,publish-app,publish-plugins,generate-key}.mjs",
        "tests/*.test.mjs",
        "tests/ui.spec.ts",
        "tests/browser.ts",
        "vite.config.ts",
        "playwright.config.ts"
      ],
      "project": [
        "src/**/*.{ts,svelte}",
        "controller/src/**/*.ts",
        "shared/**/*.ts",
        "sdk/**/*.ts",
        "scripts/**/*.{mjs,mts}",
        "tests/**/*.{mjs,ts}",
        "vite.config.ts",
        "playwright.config.ts"
      ],
      "ignore": ["**/*.d.ts", "**/*.d.mts"]
    },
    "services/*": {
      "entry": ["src/index.ts", "public/app.js"],
      "project": ["src/**/*.ts", "public/*.js"],
      "ignore": ["worker-configuration.d.ts"],
      "ignoreDependencies": ["cloudflare"]
    },
    "plugins/*": {
      "entry": ["src/worker.ts", "ui/main.ts", "contract.ts"],
      "project": ["src/**/*.ts", "ui/**/*.ts", "contract.ts"]
    }
  },
  "ignoreDependencies": [
    "@tauri-apps/cli",
    "@tauri-apps/plugin-autostart",
    "svelte-check",
    "typescript",
    "vite",
    "@typescript/native"
  ]
}
