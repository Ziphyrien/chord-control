{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "paths": { "$platform": ["src/lib/platform.ts"] },
      "entry": [
        "src/routes/**/+*.{ts,svelte}",
        "src/lib/platform.ts",
        "src/**/*.test.ts",
        "controller/src/index.ts",
        "sdk/**/*.ts",
        "shared/**/*.ts",
        "scripts/{build-controller,build-sidecar,build-plugins,prepare-app-release,publish-app,publish-plugins,generate-key}.mjs",
        "tests/*.test.mjs",
        "tests/windows-observer-cli.mjs",
        "scripts/test-native-plugin-build.mjs",
        "tests/ui.spec.ts",
        "tests/browser.ts",
        "vite.config.ts",
        "playwright.config.ts"
      ],
      "project": [
        "src/**/*.{ts,svelte}",
        "controller/src/**/*.ts",
        "shared/**/*.ts",
        "sdk/**/*.ts",
        "scripts/**/*.{mjs,mts}",
        "tests/**/*.{mjs,ts}",
        "vite.config.ts",
        "playwright.config.ts"
      ],
      "ignore": ["**/*.d.ts", "**/*.d.mts"]
    },
    "services/*": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"],
      "ignore": ["worker-configuration.d.ts"],
      "ignoreDependencies": ["cloudflare"]
    },
    "services/*/ui": {
      "entry": ["src/routes/**/+*.{ts,svelte}", "vite.config.ts", "build-static.mjs"],
      "project": ["src/**/*.{ts,js,svelte}", "testing/*.mjs", "vite.config.ts", "build-static.mjs"]
    },
    "plugins/*/ui": {
      "entry": ["src/routes/**/+*.{ts,svelte}", "src/hooks.ts", "vite.config.ts"],
      "project": ["src/**/*.{ts,svelte}", "vite.config.ts"]
    },
    "packages/*": {
      "entry": ["*.ts", "*.svelte", "*.mjs", "tests/*.test.mjs"],
      "project": ["**/*.{ts,svelte,mjs}"]
    },
    "plugins/*": {
      "entry": ["src/worker.ts"],
      "project": ["src/**/*.ts", "input.ts"]
    }
  },
  "ignoreDependencies": [
    "@tauri-apps/cli",
    "svelte-check",
    "typescript",
    "vite",
    "@typescript/native"
  ]
}
