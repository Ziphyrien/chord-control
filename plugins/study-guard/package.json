{
  "name": "com.chord.study-guard",
  "version": "1.2.0",
  "private": true,
  "description": "浏览器启动验证与 Windows 默认壁纸保护，保留原有设置以便恢复",
  "type": "module",
  "control": {
    "name": "学习权限",
    "minHostVersion": "0.3.0",
    "permissions": [
      "process-control",
      "registry-current-user",
      "wallpaper"
    ],
    "services": {
      "provides": [],
      "requires": [
        "study.password.v1"
      ]
    },
    "ui": "ui/index.html",
    "uiScript": "ui/main.ts"
  }
}
