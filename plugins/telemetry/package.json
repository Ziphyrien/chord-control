{
  "name": "com.chord.telemetry",
  "version": "1.1.0",
  "private": true,
  "description": "定期汇报主程序、插件和壁纸诊断状态，支持远程排查",
  "type": "module",
  "control": {
    "name": "运行遥测",
    "native": {
      "manifest": "native/Cargo.toml",
      "binary": "chord-observer",
      "asset": "native/chord-observer.exe"
    },
    "minHostVersion": "0.4.6",
    "permissions": [
      "diagnostics",
      "network",
      "filesystem",
      "process-control"
    ],
    "services": {
      "provides": [],
      "requires": []
    },
    "uiProject": "ui/vite.config.ts"
  }
}
