{
  "name": "com.chord.telemetry",
  "version": "1.2.4",
  "private": true,
  "description": "默认仅汇报运行摘要，系统权限及关联审计诊断由用户按需采集",
  "type": "module",
  "control": {
    "name": "运行遥测",
    "native": {
      "manifest": "native/Cargo.toml",
      "binary": "chord-observer",
      "asset": "native/chord-observer.exe"
    },
    "minHostVersion": "0.4.17",
    "permissions": [
      "native-asset",
      "diagnostics",
      "network",
      "filesystem"
    ],
    "services": {
      "provides": [],
      "requires": []
    },
    "uiProject": "ui/vite.config.ts"
  }
}
