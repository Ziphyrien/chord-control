{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "types": ["$app/types", "node", "svelte"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.svelte",
    "controller/src/**/*.ts",
    "shared/**/*.ts",
    "sdk/**/*.ts",
    "sdk/**/*.svelte",
    "plugins/*/src/**/*.ts",
    "plugins/*/input.ts",
    "packages/**/*.ts",
    "packages/**/*.svelte",
    "tests/**/*.ts",
    "tests/**/*.svelte",
    "scripts/**/*.d.mts",
    "vite.config.ts",
    "playwright.config.ts"
  ],
  "exclude": [
    "**/node_modules",
    "**/.svelte-kit",
    "**/dist",
    "build",
    "release",
    "src-tauri/target"
  ]
}
