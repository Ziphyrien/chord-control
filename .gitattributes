# Reproducible text checkouts across Windows and Unix hosts.
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=lf
*.svg text eol=lf
bun.lock text eol=lf
*.pem text eol=lf

# Never normalize signed artifacts or opaque assets.
*.exe binary
*.dll binary
*.sig binary
*.avif binary
*.bmp binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.mp3 binary
*.ogg binary
*.wav binary
*.woff binary
*.woff2 binary
*.wasm binary
